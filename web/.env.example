# Laravel backend (same site as this app so the session cookie is shared).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WhatsApp Embedded Signup v4 (Meta app + Facebook Login for Business config).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Public site contact links (/contact). Leave empty until the founder sets them:
# the page then says "coming soon" instead of showing a broken link.
# WhatsApp in international format, digits only (e.g. 9665XXXXXXXX).
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Search engines may index the public site only after launch (Gate 0).
# The app and the legal drafts stay noindex regardless.
NEXT_PUBLIC_SITE_INDEXABLE=false

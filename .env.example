APP_NAME="CODEX Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=codex
DB_USERNAME=codex
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Per-tenant phone hashing key (ADR-008). Generate with: php -r "echo bin2hex(random_bytes(32));"
CODEX_SUBJECT_HASH_KEY=

# Salla Partners app (private app in P0b–P2)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=

# Next.js frontend (ADR-002): same top-level domain as the API
FRONTEND_URL=http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3001

# Meta (WhatsApp Tech Provider)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# ADR-006 — decide with the lawyer before the first number (AE or BH)
META_DATA_LOCALIZATION_REGION=

# AI Sales Agent (P3, ADR-007). No key = the agent hands every message to a
# person (provider unavailable). Never commit a real key. Paid: get the
# founder's approval first.
ANTHROPIC_API_KEY=
CODEX_AI_MODEL=claude-haiku-5-5
# Catalog/FAQ embeddings (Voyage AI). Off = search runs on text alone.
VOYAGEAI_API_KEY=
CODEX_EMBEDDINGS_ENABLED=false
# Local demo only: the demo store has no Salla sync, so allow older prices.
# Production must stay at 15 (US-E09-01).
CODEX_PRICE_MAX_AGE_MINUTES=15
